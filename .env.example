# Example environment configuration for monobank-2048.
# Copy the relevant blocks into gitignored files under .secrets/ and fill real values.
# NEVER commit real tokens or the device PIN.
#
#   .secrets/telegram.env  -> Telegram alert bridge
#   .secrets/device.env    -> monobank device PIN (only for opt-in --auto-login)

# ---- Telegram bridge (.secrets/telegram.env) ----
TG_BOT_TOKEN=123456789:replace-with-your-bot-token
TG_CHAT_ID=000000000
TG_USER_HANDLE=@your_handle

# ---- Device auto-login (.secrets/device.env) ----
# Optional. If unset, the live runner treats the auth wall as FATAL and a human unlocks.
# The 4-digit monobank PIN. Keep it ONLY here (gitignored) — never in code, logs, or CLI args.
MONO_PIN=0000
