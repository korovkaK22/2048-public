# ===== Large binaries / build outputs (Windows tools — re-download per platform) =====
**/platform-tools/
project/tools/ffmpeg/
project/tools/scrcpy/
*.exe
*.dll
*~
*.apk
# Ваги n-tuple мережі + run/ рушія (багатомегабайтні блоби).
# Чемпіонські ваги роздаються через GitHub Release — див. scripts/setup/fetch_weights.sh
*.bin
project/tools/ntuple/run/
# PGO-профіль: містить абсолютні шляхи збірки, час і відбитки системних DLL.
# Регенерується локально — див. project/tools/ntuple/BUILD.md
*.pgo
# Android build-артефакти та машинно-локальний конфіг SDK.
# УВАГА: патерн зі слешем прив'язується до кореня репо, тому шлях мусить бути повним
# (раніше `ondevice-apk/local.properties` не ловив `project/ondevice-apk/...`).
project/ondevice-apk/**/build/
project/ondevice-apk/**/.gradle/
local.properties
.gradle/

# ===== Локальний стан Claude Code =====
# CLAUDE.md і .claude/agents/ — у git (репо приватне), щоб правила бачила кожна
# копія/worktree. Машинно-локальне — ні.
.claude/settings.local.json
.claude/worktrees/

