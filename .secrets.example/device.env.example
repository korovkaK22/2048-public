# Copy to .secrets/device.env (gitignored) and fill in the real value.
# OPTIONAL — only needed for opt-in `--auto-login` on the monobank auth wall.
# Without it the live runner treats the auth wall as FATAL and a human unlocks.
# The 4-digit monobank device PIN. Keep it ONLY here — never in code, logs, or CLI args.
MONO_PIN=0000
